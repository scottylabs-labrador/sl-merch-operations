# --- required -------------------------------------------------------------
AGENTMAIL_API_KEY=                 # inbox-scoped key for scottylabs-merch@agentmail.to
AGENTMAIL_INBOX_ID=scottylabs-merch@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=          # printed once by scripts/register_webhook.py (whsec_...)
DATABASE_URL=                      # Postgres URL (on Sheltie: the database's internal URL); leave empty locally for sqlite
PUBLIC_BASE_URL=https://merch.sheltie.scottylabs.org
VOLUNTEER_PASSCODE=                # shared with GBM volunteers
ADMIN_PASSCODE=                    # officers only
SESSION_SECRET=                    # long random string

# --- optional -------------------------------------------------------------
OPENROUTER_API_KEY=                # enables LLM parse fallback, buyer reply classification, support desk (https://openrouter.ai/keys)
LLM_MODEL=z-ai/glm-5.3-flash       # any OpenRouter model id with structured outputs
LLM_PROVIDERS=coreweave,fireworks,baseten   # OpenRouter provider slugs, tried in order; empty = any provider
LLM_ZDR=1                          # only zero-data-retention endpoints that do not train on prompts
LLM_MAX_TOKENS=4096                # cap per call incl. reasoning; LLM_REASONING_EFFORT=low keeps adversarial prompts from stalling the model
LLM_BASE_URL=https://openrouter.ai/api/v1   # any OpenAI-compatible Chat Completions endpoint
JEV_ENABLED=1                      # Jev (Typesafe System One) decisions: triage, reply guardrail, export rows. Uses OPENROUTER_API_KEY via OpenRouter's decisions endpoint
JEV_MODEL=typesafe/jev-1.13        # OpenRouter model id; or set JEV_URL=https://api.typesafe.ai/v1/systemone + JEV_API_KEY + JEV_MODEL=jev-latest to go direct
ORG_EMAIL=scottylabs@cmu.edu
ORG_NAME=ScottyLabs
STORE_NAME=ScottyLabs Merch Store
GBM_INFO=our weekly ScottyLabs GBM (general body meeting). Times and rooms are posted at https://scottylabs.org and https://luma.com/scottylabs.
EMAIL_ORDER_INTAKE=0              # 1 = also create orders from emailed notifications/receipts (spoofable; off by default)
EXPORT_IGNORE_ITEMS=donation       # export rows whose item name contains any of these are not merch
TRUSTED_SENDERS=tartanconnect@andrew.cmu.edu,scottylabs@cmu.edu,<officer whose Gmail forwards>@andrew.cmu.edu
BRING_LIST_DAY=tue
BRING_LIST_TIME=09:00
TIMEZONE=America/New_York
